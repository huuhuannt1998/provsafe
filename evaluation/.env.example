# Environment configuration for PROVSAFE evaluation

# ── LM Studio (local inference, no key needed) ──
LMSTUDIO_URL=http://localhost:1234/v1/chat/completions
LMSTUDIO_KEY=lm-studio

# ── Groq (free tier: 30 req/min) ──
# Sign up at https://console.groq.com/ and create an API key
# Model: llama-3.1-70b-versatile
GROQ_API_KEY=your_groq_api_key_here

# ── Google Gemini (free tier: 15 req/min) ──
# Get your key at https://aistudio.google.com/apikey
# Model: gemini-1.5-flash (via OpenAI-compatible endpoint)
GEMINI_API_KEY=your_gemini_api_key_here

# ── OpenWebUI LLM API (optional, for cluster use) ──
OPENWEBUI_URL=http://cci-siscluster1.charlotte.edu:8080/api/chat/completions
OPENWEBUI_API_KEY=your_openwebui_api_key_here

# SmartThings API
# Get your token from: https://account.smartthings.com/tokens
# Required permissions: r:devices:*, x:devices:*, r:locations:*
SMARTTHINGS_TOKEN=your_smartthings_personal_access_token_here

# Evaluation parameters (optional overrides)
# DEFAULT_TIMEOUT=30.0
# MAX_RETRIES=3
# OUTPUT_DIR=results
